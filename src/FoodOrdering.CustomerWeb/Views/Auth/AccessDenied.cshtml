@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="fine-card p-5">
                <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
                <h2 class="text-white brand-font mb-2">Access Restricted</h2>
                <p class="text-muted fs-5 mb-4">
                    The Customer Web Portal is reserved exclusively for Customer accounts. Non-customer roles (Admin, Chef, Waiter, Delivery) are restricted from accessing customer portal features.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-gold">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-gold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In as Customer
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
