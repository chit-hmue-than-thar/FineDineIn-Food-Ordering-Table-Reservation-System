@model FoodOrdering.Domain.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="fine-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock text-warning display-4"></i>
                    <h2 class="text-white brand-font mt-2">Reset Password</h2>
                    <p class="text-muted small">Enter your registered email address to receive a 6-digit OTP code.</p>
                </div>

                <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted small fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-warning"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control fine-input" placeholder="customer@finedinein.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2.5 mb-3">
                        <i class="bi bi-send me-2"></i> Send OTP Code
                    </button>
                </form>

                <div class="text-center pt-2 border-top border-secondary border-opacity-25">
                    <a asp-controller="Auth" asp-action="Login" class="text-warning small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
