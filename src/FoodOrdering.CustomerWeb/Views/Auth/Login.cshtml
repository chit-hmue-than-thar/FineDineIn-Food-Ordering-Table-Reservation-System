@model FoodOrdering.Domain.DTOs.LoginDto
@{
    ViewData["Title"] = "Sign In - Customer Portal";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="py-5" style="background-color: var(--bg-cream, #FAF7F2); min-height: 85vh; display: flex; align-items: center;">
    <div class="container" style="max-width: 960px;">
        
        <!-- Main FLAVORIA Luxury Split Login Card (Matching website warm gold & dark luxury theme) -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #24201C 0%, #151311 100%);">
            <div class="row g-0">
                
                <!-- Left Side: Login Form -->
                <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between text-white">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <i class="bi bi-crown fs-4" style="color: #C59D5F;"></i>
                            <span class="fw-bold tracking-widest text-uppercase" style="letter-spacing: 2px; font-size: 0.9rem; color: #C59D5F;">FLAVORIA</span>
                        </div>

                        <!-- Welcome Back Title in White Color -->
                        <h1 class="display-6 fw-bold mb-2 text-white font-serif">Login</h1>
                        <p class="small mb-4 text-white-50" style="font-size: 0.88rem; line-height: 1.5;">
                            Welcome! Please fill in your email address and password to sign into your account.
                            Don't have an account? <a asp-action="Register" class="text-decoration-underline fw-bold" style="color: #C59D5F;">Sign Up</a>
                        </p>

                        <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <!-- Underlined Input: Email Address -->
                            <div class="mb-4 position-relative">
                                <div class="d-flex align-items-center border-bottom border-white-50 pb-2">
                                    <i class="bi bi-person text-white-50 fs-5 me-3"></i>
                                    <input asp-for="Email" class="form-control bg-transparent border-0 text-white p-0 shadow-none" 
                                           placeholder="Email Address" required style="font-size: 0.95rem;" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Underlined Input: Password -->
                            <div class="mb-4 position-relative">
                                <div class="d-flex align-items-center border-bottom border-white-50 pb-2">
                                    <i class="bi bi-lock text-white-50 fs-5 me-3"></i>
                                    <input asp-for="Password" class="form-control bg-transparent border-0 text-white p-0 shadow-none" 
                                           type="password" placeholder="Password" required style="font-size: 0.95rem;" />
                                    <a asp-controller="Auth" asp-action="ForgotPassword" class="small text-white-50 text-decoration-none ms-auto" style="white-space: nowrap; font-size: 0.8rem;">
                                        Forgot Password?
                                    </a>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="form-check mb-0">
                                    <input asp-for="RememberMe" class="form-check-input bg-transparent border-white-50" type="checkbox" id="rememberMe" />
                                    <label class="form-check-label small text-white-50" for="rememberMe">Remember Me</label>
                                </div>

                                <button type="submit" class="btn rounded-pill px-4 py-2 fw-bold text-dark shadow-sm" style="min-width: 110px; background-color: #FFFFFF;">
                                    Login
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="pt-3 border-top border-white-10 text-white-50 small">
                        <span>&copy; 2026 FLAVORIA Fine Dining Portal</span>
                    </div>
                </div>

                <!-- Right Side: Gourmet Plated Food Image -->
                <div class="col-lg-6 d-none d-lg-block position-relative" style="background: url('https://images.unsplash.com/photo-1544025162-d76694265947?w=700') center/cover no-repeat;">
                    <div class="h-100 w-100" style="background: rgba(26, 24, 22, 0.25);"></div>
                </div>

            </div>
        </div>

    </div>
</div>

<style>
    ::placeholder { color: rgba(255, 255, 255, 0.5) !important; }
    .form-control:focus { background-color: transparent !important; color: #ffffff !important; box-shadow: none !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
