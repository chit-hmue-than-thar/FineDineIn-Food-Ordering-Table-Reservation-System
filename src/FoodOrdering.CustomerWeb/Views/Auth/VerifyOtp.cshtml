@model FoodOrdering.Domain.DTOs.VerifyOtpDto
@{
    ViewData["Title"] = "OTP Verification & Password Reset";
    var demoOtp = TempData["DemoOtp"] as string;
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="fine-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-check text-warning display-4"></i>
                    <h2 class="text-white brand-font mt-2">Verify OTP</h2>
                    <p class="text-muted small">Enter the 6-digit OTP sent to <strong>@Model.Email</strong> along with your new password.</p>
                </div>

                @if (!string.IsNullOrEmpty(demoOtp))
                {
                    <div class="alert alert-warning alert-dismissible fade show border-0 bg-warning text-dark bg-opacity-75" role="alert">
                        <i class="bi bi-key-fill me-2 fs-5"></i>
                        <strong>Demo Simulated OTP:</strong> <span class="fs-5 font-monospace fw-bold">@demoOtp</span>
                    </div>
                }

                <form asp-controller="Auth" asp-action="VerifyOtp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label text-muted small fw-semibold">6-Digit OTP Code</label>
                        <input asp-for="OtpCode" class="form-control fine-input text-center font-monospace fs-4 tracking-wider" maxlength="6" placeholder="000000" />
                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-muted small fw-semibold">New Password</label>
                        <input asp-for="NewPassword" class="form-control fine-input" type="password" placeholder="At least 6 characters" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label text-muted small fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmNewPassword" class="form-control fine-input" type="password" placeholder="Repeat new password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2.5 mb-3">
                        <i class="bi bi-check-lg me-2"></i> Update Password & Sign In
                    </button>
                </form>

                <div class="text-center pt-2 border-top border-secondary border-opacity-25">
                    <a asp-controller="Auth" asp-action="Login" class="text-warning small text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
