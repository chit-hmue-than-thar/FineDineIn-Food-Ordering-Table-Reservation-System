@model List<FoodOrdering.Domain.Entities.TblSale>
@{
    ViewData["Title"] = "My Orders";
}

<div class="py-5" style="background-color: var(--bg-cream); min-height: 80vh;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-gold">
            <div>
                <span class="text-uppercase tracking-wider text-gold font-serif text-sm fw-bold">Customer Portal</span>
                <h2 class="display-6 font-serif fw-bold text-dark mb-0">My Dine-in Orders</h2>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-gold rounded-pill px-4 fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Order More Food
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 rounded-3 text-center" style="background-color: #d1e7dd; color: #0f5132;">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info border-0 shadow-sm mb-4 rounded-3 text-center">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 my-4 bg-white rounded-4 shadow-sm p-5">
                <i class="bi bi-receipt text-gold display-1 mb-3"></i>
                <h4 class="font-serif fw-bold text-dark mb-2">No Orders Found</h4>
                <p class="text-muted mb-4">You haven't placed any dine-in orders yet. Explore our exquisite menu and enjoy a luxury fine dining experience!</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-gold btn-lg rounded-pill px-5 fw-bold">
                    Explore Menu
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var order in Model)
                {
                    string statusBadgeClass = order.Status switch
                    {
                        FoodOrdering.Domain.Enums.SaleStatus.Placed => "bg-secondary",
                        FoodOrdering.Domain.Enums.SaleStatus.PaymentPending => "bg-warning text-dark",
                        FoodOrdering.Domain.Enums.SaleStatus.Paid => "bg-info text-dark",
                        FoodOrdering.Domain.Enums.SaleStatus.Preparing => "bg-primary",
                        FoodOrdering.Domain.Enums.SaleStatus.Ready => "bg-success",
                        FoodOrdering.Domain.Enums.SaleStatus.Completed => "bg-dark",
                        FoodOrdering.Domain.Enums.SaleStatus.Cancelled => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
                            <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <span class="text-muted small">Voucher No:</span>
                                    <strong class="font-serif text-dark ms-1">#@order.VoucherNo</strong>
                                    <span class="mx-2 text-muted">|</span>
                                    <span class="text-muted small">Placed on:</span>
                                    <span class="text-dark small ms-1">@order.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                </div>
                                <div>
                                    <span class="badge px-3 py-2 rounded-pill @statusBadgeClass fw-bold me-2">
                                        <i class="bi bi-dot me-1"></i> @order.Status
                                    </span>
                                    <span class="badge px-3 py-2 rounded-pill text-white fw-bold" style="background-color: var(--primary-dark);">
                                        Dine-In @(order.Table != null ? $" (Table {order.Table.TableNumber})" : "")
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var detail in order.SaleDetails)
                                            {
                                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                    @detail.FoodName <strong class="text-gold ms-1">x@detail.Quantity</strong>
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(order.Notes))
                                        {
                                            <p class="text-muted small mb-0"><i class="bi bi-sticky me-1"></i> Note: @order.Notes</p>
                                        }
                                    </div>
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0 border-start-md ps-md-4">
                                        <p class="text-muted small mb-1">Total Amount</p>
                                        <h4 class="font-serif fw-bold text-dark mb-3">MMK @order.TotalAmount.ToString("N0")</h4>
                                        
                                        <div class="d-flex justify-content-md-end gap-2 flex-wrap">
                                            @if (order.Status == FoodOrdering.Domain.Enums.SaleStatus.PaymentPending)
                                            {
                                                <a asp-controller="Payment" asp-action="Index" asp-route-saleId="@order.Id" class="btn btn-warning btn-sm rounded-pill fw-bold px-3">
                                                    <i class="bi bi-credit-card me-1"></i> Pay Now
                                                </a>
                                            }
                                            <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                                <i class="bi bi-geo-alt me-1"></i> Track Order
                                            </a>
                                            <a asp-action="Receipt" asp-route-id="@order.Id" class="btn btn-gold btn-sm rounded-pill px-3 fw-bold">
                                                <i class="bi bi-receipt me-1"></i> Receipt
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
