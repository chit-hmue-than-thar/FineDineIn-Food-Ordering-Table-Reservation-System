@model FoodOrdering.CustomerWeb.Models.ReservationWizardViewModel
@{
    ViewData["Title"] = "Book a Table - 5-Step Reservation Wizard";
}

<div class="py-5" style="background-color: #F8F9FA; min-height: 90vh;">
    <div class="container" style="max-width: 680px;">
        
        <!-- Top Breadcrumb -->
        <div class="d-flex align-items-center gap-2 mb-4 text-muted small">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Home
            </a>
            <span>&gt;</span>
            <span class="text-primary fw-bold">Steps</span>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 rounded-3 text-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- 5-STEP STEPPER BAR -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white text-center">
            <div class="d-flex justify-content-between align-items-center position-relative px-2">
                <!-- Step Connecting Line -->
                <div class="position-absolute top-50 start-0 end-0 translate-middle-y bg-light" style="height: 3px; z-index: 1;"></div>
                <div class="position-absolute top-50 start-0 translate-middle-y bg-success transition-all" id="stepperProgress" style="height: 3px; z-index: 1; width: @(Model.IsSuccess ? "100%" : "0%");"></div>

                <!-- Step Circles -->
                <div class="wizard-step-circle active" id="stepCircle-1" style="z-index: 2;">1</div>
                <div class="wizard-step-circle @(Model.IsSuccess ? "active" : "")" id="stepCircle-2" style="z-index: 2;">2</div>
                <div class="wizard-step-circle @(Model.IsSuccess ? "active" : "")" id="stepCircle-3" style="z-index: 2;">3</div>
                <div class="wizard-step-circle @(Model.IsSuccess ? "active" : "")" id="stepCircle-4" style="z-index: 2;">4</div>
                <div class="wizard-step-circle @(Model.IsSuccess ? "active" : "")" id="stepCircle-5" style="z-index: 2;">5</div>
            </div>

            <!-- Step Titles -->
            <div class="d-flex justify-content-between mt-3 small font-serif fw-bold text-muted px-1" id="stepTitles">
                <span class="text-primary" id="title-1">Contact</span>
                <span id="title-2">Date & Time</span>
                <span id="title-3">Payment</span>
                <span id="title-4">Upload Receipt</span>
                <span id="title-5">Receipt</span>
            </div>
        </div>

        <!-- WIZARD FORM CONTAINER -->
        <form asp-action="Book" asp-controller="Reservation" method="post" enctype="multipart/form-data" id="reservationWizardForm">
            @Html.AntiForgeryToken()

            <!-- STEP 1: CONTACT DETAILS (Mandatory Inputs) -->
            <div class="wizard-step-panel @(Model.IsSuccess ? "d-none" : "")" id="stepPanel-1">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <span class="text-uppercase tracking-wider text-muted small fw-bold d-block mb-1">Appointment</span>
                    <h2 class="font-serif fw-bold text-dark mb-2">Book an Appointment</h2>
                    <p class="text-muted small mb-4">Please enter your contact details. Our fine-dining concierge team will confirm your table reservation.</p>

                    <div class="mb-3">
                        <label class="form-label font-serif fw-bold text-dark small">Full Name*</label>
                        <input type="text" name="fullName" id="inputFullName" class="form-control form-control-lg border-gold rounded-3" 
                               placeholder="Enter your full name" value="@Model.FullName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-serif fw-bold text-dark small">Email Address*</label>
                        <input type="email" name="emailAddress" id="inputEmailAddress" class="form-control form-control-lg border-gold rounded-3" 
                               placeholder="Enter your email address" value="@Model.EmailAddress" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-serif fw-bold text-dark small">Phone Number*</label>
                        <input type="tel" name="phoneNumber" id="inputPhoneNumber" class="form-control form-control-lg border-gold rounded-3" 
                               placeholder="+95 9 123456789" value="@Model.PhoneNumber" required />
                    </div>

                    <div class="row g-2 pt-2">
                        <div class="col-6">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold">Close</a>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-dark w-100 py-3 rounded-3 fw-bold" onclick="goToStep(2)">Step 1 / 5 &gt;</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 2: PREFERRED DATE / TIME SLOT & TABLE SELECTION -->
            <div class="wizard-step-panel d-none" id="stepPanel-2">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <span class="text-uppercase tracking-wider text-muted small fw-bold d-block mb-1">Preferred Date / Time</span>
                    <h2 class="font-serif fw-bold text-dark mb-2">Preferred Date & Time</h2>
                    <p class="text-muted small mb-4">* Restaurant schedule shown. Table bookings are available up to 1 week from current time.</p>

                    <!-- Day Selector Pills -->
                    <div class="mb-4">
                        <label class="form-label font-serif fw-bold text-dark small">Select Date</label>
                        <div class="d-flex gap-2 overflow-auto pb-2" id="dayPillsContainer">
                            @for (int i = 0; i < 7; i++)
                            {
                                var d = DateTime.Today.AddDays(i);
                                var isSel = d.Date == Model.SelectedDate.Date;
                                <button type="button" class="btn border p-3 flex-fill text-center rounded-3 day-pill @(isSel ? "btn-dark text-white fw-bold" : "bg-light text-dark")"
                                        onclick="selectDay('@d.ToString("yyyy-MM-dd")', this)">
                                    <span class="small d-block text-uppercase">@d.ToString("ddd")</span>
                                    <span class="h5 mb-0 fw-bold">@d.Day</span>
                                </button>
                            }
                        </div>
                        <input type="hidden" name="reservationDate" id="inputReservationDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Time Slot Grid Chips -->
                    <div class="p-3 bg-light rounded-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="font-serif fw-bold text-dark mb-0" id="slotSelectedDateLabel">@Model.SelectedDate.ToString("dddd, dd MMM")</h6>
                            <span class="small text-muted">Available Slots</span>
                        </div>

                        <div class="row g-2 mb-3" id="timeSlotsGrid">
                            @{
                                var slots = new[] { "09:00 - 10:00", "12:00 - 14:00", "14:00 - 15:00", "18:00 - 20:00", "20:00 - 22:00" };
                            }
                            @foreach (var s in slots)
                            {
                                var isAct = s == Model.SelectedTimeSlot;
                                <div class="col-6 col-sm-4">
                                    <button type="button" class="btn w-100 py-2 border rounded-3 text-center small slot-chip @(isAct ? "btn-primary text-white fw-bold" : "bg-white text-dark")"
                                            onclick="selectTimeSlot('@s', this)">
                                        @s
                                    </button>
                                </div>
                            }
                        </div>
                        <input type="hidden" name="timeSlot" id="inputTimeSlot" value="@Model.SelectedTimeSlot" />

                        <div class="d-flex gap-3 small text-muted pt-2 border-top">
                            <span><i class="bi bi-circle-fill text-success me-1"></i> Open</span>
                            <span><i class="bi bi-circle-fill text-secondary me-1"></i> Booked</span>
                            <span><i class="bi bi-circle-fill text-primary me-1"></i> Selected</span>
                        </div>
                    </div>

                    <!-- Party Size & Table Selection -->
                    <div class="mb-4">
                        <label class="form-label font-serif fw-bold text-dark small">Party Size (Guests)</label>
                        <select name="partySize" id="inputPartySize" class="form-select form-select-lg border-gold rounded-3 mb-3">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i" selected="@(Model.PartySize == i)">@i @(i == 1 ? "Guest" : "Guests")</option>
                            }
                        </select>

                        <label class="form-label font-serif fw-bold text-dark small">Select Table</label>
                        <div class="row g-2">
                            @foreach (var table in Model.Tables)
                            {
                                <div class="col-6">
                                    <div class="p-3 border rounded-3 text-center cursor-pointer table-card @(table.IsAvailableForSlot ? "border-gold" : "bg-light opacity-50")"
                                         onclick="selectTable('@table.TableId', this)">
                                        <i class="bi bi-headset-vr display-6 text-gold d-block mb-1"></i>
                                        <strong class="font-serif d-block">Table #@table.TableNumber</strong>
                                        <span class="small text-muted">@table.LocationType Zone (@table.Capacity Guests)</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <input type="hidden" name="tableId" id="inputTableId" value="@(Model.Tables.FirstOrDefault(t => t.IsAvailableForSlot)?.TableId)" required />
                    </div>

                    <div class="row g-2 pt-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold" onclick="goToStep(1)">Previous</button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-dark w-100 py-3 rounded-3 fw-bold" onclick="goToStep(3)">Step 2 / 5 &gt;</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 3: SELECT BANK & PAYMENT DETAILS -->
            <div class="wizard-step-panel d-none" id="stepPanel-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <span class="text-uppercase tracking-wider text-muted small fw-bold d-block mb-1">Payment</span>
                    <h2 class="font-serif fw-bold text-dark mb-2">Payment</h2>
                    <p class="text-muted small mb-4">Table reservation deposit fees can be paid via KBZPay or WavePay listed below. Upload receipt after completing transfer.</p>

                    <!-- Bank Type Options -->
                    <label class="form-label font-serif fw-bold text-dark small">Select Bank / Mobile Wallet</label>
                    <div class="mb-4">
                        <div class="p-3 border rounded-3 mb-2 d-flex align-items-center justify-content-between cursor-pointer bank-card border-gold" onclick="selectBank('KBZPay', this)">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge px-3 py-2 text-white fw-bold rounded-2" style="background-color: #127cc1;">KBZPay</span>
                                <span class="fw-bold text-dark">KBZPay Transfer</span>
                            </div>
                            <input type="radio" name="selectedBank" value="KBZPay" checked class="form-check-input" />
                        </div>
                        <div class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer bank-card" onclick="selectBank('WavePay', this)">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge px-3 py-2 text-dark fw-bold rounded-2" style="background-color: #ffe600;">WavePay</span>
                                <span class="fw-bold text-dark">WavePay Transfer</span>
                            </div>
                            <input type="radio" name="selectedBank" value="WavePay" class="form-check-input" />
                        </div>
                    </div>

                    <!-- Payment Details Card matching reference -->
                    <div class="p-4 border rounded-4 bg-light mb-4">
                        <h6 class="font-serif fw-bold text-dark mb-3">Submit via phone number</h6>
                        
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Kpay Phone Number:</span>
                            <span class="fw-bold text-dark">
                                <span id="kpayPhone">@Model.KPayNumber</span>
                                <button type="button" class="btn btn-sm btn-link text-dark p-0 ms-1" onclick="navigator.clipboard.writeText('@Model.KPayNumber'); alert('Phone number copied!');">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Kpay Receiver Name:</span>
                            <span class="fw-bold text-dark">@Model.KPayAccountName</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted small">Pay Total:</span>
                            <span class="fw-bold text-primary">50,000 MMK / Table</span>
                        </div>

                        <!-- Expandable QR Code Dropdown Button -->
                        <button type="button" class="btn btn-dark w-100 py-2 rounded-3 text-center fw-bold text-white mb-2" data-bs-toggle="collapse" data-bs-target="#qrCodeBox">
                            Show QR Code <i class="bi bi-chevron-down ms-1"></i>
                        </button>
                        <div class="collapse text-center p-3 bg-white rounded-3 mt-2" id="qrCodeBox">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=09791234567" alt="KBZPay QR Code" class="img-fluid rounded-3 mb-2" style="max-width: 160px;" />
                            <p class="text-muted small mb-0">Scan with KBZPay app to pay 50,000 MMK</p>
                        </div>
                    </div>

                    <div class="row g-2 pt-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold" onclick="goToStep(2)">Previous</button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-dark w-100 py-3 rounded-3 fw-bold" onclick="goToStep(4)">Step 3 / 5 &gt;</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 4: UPLOAD PAYMENT SCREENSHOT -->
            <div class="wizard-step-panel d-none" id="stepPanel-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <span class="text-uppercase tracking-wider text-muted small fw-bold d-block mb-1">Upload Receipt</span>
                    <h2 class="font-serif fw-bold text-dark mb-2">Upload Receipt</h2>
                    <p class="text-muted small mb-4">Select receipt image file from your device after completing transfer.</p>

                    <!-- Instructions Card matching reference -->
                    <div class="p-4 border rounded-4 bg-light mb-4">
                        <h6 class="font-serif fw-bold text-dark mb-2">How to Upload Your Receipt</h6>
                        <ol class="small text-muted ps-3 mb-0">
                            <li class="mb-1">Tap "Upload Photo" below.</li>
                            <li class="mb-1">Select the receipt photo you wish to submit.</li>
                            <li class="mb-1">Once uploaded, the status will show "File Selected".</li>
                            <li class="mb-0">Check Terms and tap "Submit" to finalize.</li>
                        </ol>
                    </div>

                    <!-- File Upload Input -->
                    <div class="mb-4">
                        <label class="form-label font-serif fw-bold text-dark small">Upload Photo (PNG / JPG)</label>
                        <input type="file" name="paymentScreenshot" id="paymentScreenshot" class="form-control form-control-lg border-gold rounded-3" accept="image/*" required onchange="fileSelected(this)" />
                        <div id="fileSuccessText" class="text-success small mt-2 d-none fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> Image file successfully selected!
                        </div>
                    </div>

                    <!-- Terms and Conditions Checkbox -->
                    <div class="form-check mb-4">
                        <input type="checkbox" name="acceptTerms" class="form-check-input" id="termsCheck" required checked />
                        <label class="form-check-label small text-muted" for="termsCheck">
                            I've read and accept FLAVORIA's <a href="#" class="text-primary text-decoration-none fw-bold">Terms and Conditions</a>
                        </label>
                    </div>

                    <div class="row g-2 pt-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold" onclick="goToStep(3)">Previous</button>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-dark w-100 py-3 rounded-3 fw-bold">Submit</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 5: RECEIPT OUTCOME CONFIRMATION -->
            <div class="wizard-step-panel @(Model.IsSuccess ? "" : "d-none")" id="stepPanel-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
                    
                    <div class="my-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-4 p-4 mb-3" style="width: 90px; height: 90px;">
                            <i class="bi bi-check-lg display-3 text-success"></i>
                        </div>
                        <h2 class="font-serif fw-bold text-dark mb-2">Receipt Submitted Successfully</h2>
                        <p class="text-muted small">Your payment receipt has been securely uploaded & submitted.</p>
                    </div>

                    <!-- Receipt Details Box -->
                    <div class="p-4 border rounded-4 bg-light text-start mb-4">
                        <h6 class="font-serif fw-bold text-dark border-bottom pb-2 mb-3">What happens after submission?</h6>
                        <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                            <li><i class="bi bi-check2-circle text-success me-2"></i> The FLAVORIA admin team will review your payment receipt.</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Once verified, a confirmation notification will be sent via website and registered email.</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Our team will contact you via phone or email regarding table arrangement.</li>
                        </ul>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Reservation" asp-action="MyReservations" class="btn btn-outline-dark py-3 rounded-3 fw-bold">
                            View My Table Reservations
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-dark py-3 rounded-3 fw-bold">
                            Home page
                        </a>
                    </div>
                </div>
            </div>

        </form>

    </div>
</div>

<style>
    .wizard-step-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #E9ECEF;
        color: #6C757D;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .wizard-step-circle.active {
        background-color: #198754;
        color: #FFFFFF;
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
    }
    .cursor-pointer { cursor: pointer; }
    .table-card:hover { border-color: var(--accent-gold) !important; background-color: #FFFDF9; }
</style>

@section Scripts {
    <script>
        var currentStep = @(Model.IsSuccess ? 5 : 1);

        function goToStep(stepNum) {
            // Validation for Step 1
            if (currentStep === 1 && stepNum > 1) {
                var name = document.getElementById('inputFullName').value.trim();
                var email = document.getElementById('inputEmailAddress').value.trim();
                var phone = document.getElementById('inputPhoneNumber').value.trim();
                if (!name || !email || !phone) {
                    alert('Please fill out all mandatory contact fields (Full Name, Email Address, and Phone Number).');
                    return;
                }
            }

            // Hide all panels
            for (var i = 1; i <= 5; i++) {
                var panel = document.getElementById('stepPanel-' + i);
                var circle = document.getElementById('stepCircle-' + i);
                var title = document.getElementById('title-' + i);
                if (panel) panel.classList.add('d-none');
                if (circle) circle.classList.remove('active');
                if (title) title.classList.remove('text-primary');
            }

            // Activate panel & circle
            currentStep = stepNum;
            document.getElementById('stepPanel-' + stepNum).classList.remove('d-none');
            
            for (var j = 1; j <= stepNum; j++) {
                var c = document.getElementById('stepCircle-' + j);
                if (c) c.classList.add('active');
            }
            var t = document.getElementById('title-' + stepNum);
            if (t) t.classList.add('text-primary');

            // Update Progress Line
            var progress = ((stepNum - 1) / 4) * 100;
            document.getElementById('stepperProgress').style.width = progress + '%';
        }

        function selectDay(dateStr, btn) {
            document.querySelectorAll('.day-pill').forEach(b => b.className = 'btn border p-3 flex-fill text-center rounded-3 day-pill bg-light text-dark');
            btn.className = 'btn border p-3 flex-fill text-center rounded-3 day-pill btn-dark text-white fw-bold';
            document.getElementById('inputReservationDate').value = dateStr;
        }

        function selectTimeSlot(slotStr, btn) {
            document.querySelectorAll('.slot-chip').forEach(b => b.className = 'btn w-100 py-2 border rounded-3 text-center small slot-chip bg-white text-dark');
            btn.className = 'btn w-100 py-2 border rounded-3 text-center small slot-chip btn-primary text-white fw-bold';
            document.getElementById('inputTimeSlot').value = slotStr;
        }

        function selectTable(tableId, card) {
            document.querySelectorAll('.table-card').forEach(c => c.classList.remove('border-primary', 'bg-white', 'shadow-sm'));
            card.classList.add('border-primary', 'shadow-sm');
            document.getElementById('inputTableId').value = tableId;
        }

        function selectBank(bankName, card) {
            document.querySelectorAll('.bank-card').forEach(c => c.classList.remove('border-gold'));
            card.classList.add('border-gold');
            var radio = card.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
        }

        function fileSelected(input) {
            if (input.files && input.files[0]) {
                document.getElementById('fileSuccessText').classList.remove('d-none');
            }
        }
    </script>
}
