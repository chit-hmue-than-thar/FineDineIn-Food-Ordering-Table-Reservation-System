<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FLAVORIA Fine Dining</title>

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom Fine-Dining Site Styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Top Utility Bar -->
    <div class="top-bar py-2 d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4">
                <a href="tel:+12345678900"><i class="bi bi-telephone text-warning me-1"></i> +1 234 567 8900</a>
                <a href="mailto:hello@flavoria.com"><i class="bi bi-envelope text-warning me-1"></i> hello@flavoria.com</a>
            </div>
            <div>
                <span>Free Delivery on Orders Above 50,000 MMK</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span>Follow Us:</span>
                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-instagram"></i></a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- Left Nav Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">HOME</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-fragment="about-us">ABOUT</a>
                        </li>
                    </ul>

                    <!-- Center Brand Logo -->
                    <a class="navbar-brand mx-auto text-center py-0 d-flex flex-column align-items-center" asp-controller="Home" asp-action="Index">
                        <div class="d-flex align-items-center gap-1 text-warning">
                            <i class="bi bi-crown fs-5"></i>
                        </div>
                        <span>FLAVORIA</span>
                        <span class="brand-subtext">FINE DINING</span>
                    </a>

                    <!-- Right Nav Links & Search/User/Cart Icons -->
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-lg-1 align-items-center">
                        <li class="nav-item me-lg-3">
                            <a class="nav-link" asp-controller="Reservation" asp-action="Index">RESERVATION</a>
                        </li>

                        <!-- Icons Section (Search, Profile, Cart) -->
                        <li class="nav-item d-flex align-items-center gap-3 ms-lg-2">
                            <a asp-controller="Catalog" asp-action="Index" class="text-dark fs-5" title="Search Dishes"><i class="bi bi-search"></i></a>
                            
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-dark-gold dropdown-toggle d-flex align-items-center gap-1 py-1 px-2" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-circle fs-6"></i>
                                        <span class="small">@User.Identity.Name</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i> My Profile</a></li>
                                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders"><i class="bi bi-receipt me-2"></i> My Orders</a></li>
                                        <li><a class="dropdown-item" asp-controller="Reservation" asp-action="MyReservations"><i class="bi bi-calendar-check me-2"></i> My Reservations</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="Login" class="text-dark fs-5" title="Sign In">
                                    <i class="bi bi-person"></i>
                                </a>
                            }

                            <a asp-controller="Cart" asp-action="Index" class="text-dark fs-5 position-relative ms-1" title="View Cart">
                                <i class="bi bi-bag"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="flex-grow-1">
        <!-- Toast Notification Messages -->
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Feature Pillars Bar matching reference -->
    <section class="feature-pillars-bar">
        <div class="container">
            <div class="row gy-4">
                <div class="col-6 col-md-3">
                    <div class="feature-pillar-item">
                        <div class="feature-pillar-icon"><i class="bi bi-flower1"></i></div>
                        <div>
                            <div class="feature-pillar-title">Fresh Ingredients</div>
                            <div class="feature-pillar-sub">Farm to table</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="feature-pillar-item">
                        <div class="feature-pillar-icon"><i class="bi bi-person-workspace"></i></div>
                        <div>
                            <div class="feature-pillar-title">Expert Chefs</div>
                            <div class="feature-pillar-sub">Passionate & experienced</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="feature-pillar-item">
                        <div class="feature-pillar-icon"><i class="bi bi-house-heart"></i></div>
                        <div>
                            <div class="feature-pillar-title">Cozy Ambience</div>
                            <div class="feature-pillar-sub">Perfect for everyone</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="feature-pillar-item">
                        <div class="feature-pillar-icon"><i class="bi bi-truck"></i></div>
                        <div>
                            <div class="feature-pillar-title">Fast Delivery</div>
                            <div class="feature-pillar-sub">On time, every time</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center text-md-start">
            <div class="row gy-4">
                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-crown text-warning fs-4"></i>
                        <h5 class="mb-0 brand-font">FLAVORIA FINE DINING</h5>
                    </div>
                    <p class="mb-3">A perfect blend of taste, art, and ambiance. Crafted to delight your senses with unforgettable moments.</p>
                </div>
                <div class="col-md-3 offset-md-1">
                    <h6 class="text-white mb-3 brand-font">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Detail">Menu Categories</a></li>
                        <li><a asp-controller="Home" asp-action="Detail">Food Detail View</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-fragment="table-reservation">Book A Table</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white mb-3 brand-font">Contact Us</h6>
                    <p class="small mb-1"><i class="bi bi-telephone text-warning me-2"></i> +1 234 567 8900</p>
                    <p class="small mb-1"><i class="bi bi-envelope text-warning me-2"></i> hello@flavoria.com</p>
                    <p class="small mb-0"><i class="bi bi-geo-alt text-warning me-2"></i> Grand Avenue, Fine Dining District</p>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-0">&copy; 2026 FLAVORIA Fine Dining System. All Rights Reserved.</p>
                <p class="mb-0 text-muted">Inspired by Flavoria UI Architecture</p>
            </div>
        </div>
    </footer>

    <!-- CUSTOM LOGOUT CONFIRMATION MODAL UI -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #FFFFFF;">
                <div class="modal-header border-0 pb-0 pt-4 px-4 text-center d-block position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 p-3" style="background-color: #FFF5F5; width: 70px; height: 70px;">
                        <i class="bi bi-box-arrow-right text-danger display-6"></i>
                    </div>
                    <h4 class="modal-title font-serif fw-bold text-dark w-100" id="logoutModalLabel">Confirm Sign Out</h4>
                </div>
                <div class="modal-body text-center px-4 py-3">
                    <p class="text-muted mb-0" style="font-size: 0.92rem; line-height: 1.5;">
                        Are you sure you want to log out from <strong>FLAVORIA Fine Dining</strong>? You will need to sign back in to access your orders and table reservations.
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2 d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold" data-bs-dismiss="modal" style="min-width: 120px;">
                        Cancel
                    </button>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm" style="min-width: 130px;">
                            <i class="bi bi-box-arrow-right me-1"></i> Yes, Log Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
